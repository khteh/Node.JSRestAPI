{
  "name": "webapi",
  "version": "3.0.0",
  "description": "",
  "author": "Teh Kok How",
  "license": "ISC",
  "type": "module",
  "exports": "./build/index.js",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json && npm run rollup",
    "build:watch": "nodemon -e ts --exec \"npm run build\" --ignore build/** --ignore tests/**",
    "rollup": "rollup -c",
    "proto": "mkdir -p ./grpc/generated && grpc_tools_node_protoc --fatal_warnings --ts_proto_out=./grpc/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,importSuffix=.js,env=node --proto_path=./grpc/proto ./grpc/proto/*.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.7",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "http2-express": "^1.1.2",
    "inversify": "^8.1.0",
    "morgan": "^1.12.1",
    "pug": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "rotating-file-stream": "^4.0.0",
    "webapi.core": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.19",
    "@types/debug": "^4.1.13",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "grpc-tools": "^1.13.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.8.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.5.0",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0"
  },
  "keywords": [],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=26.1.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/build"
        ]
      }
    }
  }
}
