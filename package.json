{
  "name": "node.jsrestapi",
  "version": "3.0.0",
  "private": true,
  "exports": "./src/webapi/server.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khteh/Node.JSRestAPI.git"
  },
  "scripts": {
    "graph": "nx graph",
    "circular": "madge . -c",
    "typeorm": "typeorm-ts-node-esm",
    "run_migration": "npx typeorm-ts-node-esm migration:run",
    "clean": "tsc --build --clean && rimraf build src/webapi.core/build src/infrastructure/build src/webapi/build src/webapi.core/.rollup.cache src/infrastructure/.rollup.cache src/webapi/.rollup.cache",
    "copy-assets": "npx tsx tools/copyAssets.ts",
    "build": "npx tsc",
    "build_core": "npm run build --workspace=webapi.core",
    "build_infra": "npm run build --workspace=infrastructure",
    "build_webapi": "npm run build --workspace=webapi",
    "build_all": "npm-run-all clean build_core build_infra build_webapi build copy-assets",
    "proto": "npm run proto --workspace=webapi",
    "lint": "eslint --ext .js --ignore-path .gitignore ./",
    "dev": "export NODE_ENV=development PORT=4433&& concurrently \"npx tsc --watch\" \"nodemon -q build/src/webapi/server.js\"",
    "start": "export NODE_ENV=development PORT=4433&& node build/src/webapi/server.js",
    "test": "export NODE_ENV=test PORT=4433 NODE_EXTRA_CA_CERTS=server.crt&& vitest run",
    "test:ci": "export NODE_ENV=test PORT=4433 NODE_EXTRA_CA_CERTS=server.crt&& vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test_reports/junit/test-results.xml"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "ansi-regex": "^6.6.0",
    "async": "^3.2.6",
    "compression": "^1.8.2",
    "config": "^5.0.1",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "ejs": "^7.0.2",
    "elastic-apm-node": "^4.18.0",
    "email-validator": "^2.0.4",
    "express": "^5.3.0",
    "express-winston": "^4.2.0",
    "form-data": "^4.0.6",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.1",
    "morgan-json": "^1.1.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.1.2",
    "@tsconfig/node24": "^24.0.6",
    "@types/async": "3.2.26",
    "@types/chai-as-promised": "^8.0.2",
    "@types/morgan": "^1.9.10",
    "@types/morgan-json": "latest",
    "@types/multer": "^2.1.0",
    "@types/shelljs": "^0.10.0",
    "@types/sinon": "^22.0.2",
    "@types/superagent": "^8.1.11",
    "@vitest/coverage-v8": "^5.1.1",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "chai-http": "^5.2.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.3.0",
    "fs-extra": "^11.3.5",
    "madge": "^8.0.0",
    "module-name": "^0.0.1-security",
    "moq.ts": "^10.0.8",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "nx": "^24.0.6",
    "rimraf": "^6.1.3",
    "shelljs": "^0.10.0",
    "sonarqube-scanner": "^5.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "workspaces": [
    "src/webapi.core",
    "src/infrastructure",
    "src/webapi"
  ],
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    }
  }
}
